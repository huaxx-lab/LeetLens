[Unit]
Description=LeetCode remote Java language service
After=network.target

[Service]
Type=simple
User=leetcode-lsp
Group=leetcode-lsp
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/leetcode-lsp/gateway.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
MemoryHigh=620M
MemoryMax=760M
CPUQuota=150%
TasksMax=96
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/leetcode-lsp
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
