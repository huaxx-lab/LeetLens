# Optional remote Java completion service. Leave LEETCODE_LSP_SSH_HOST empty to disable it.
LEETCODE_LSP_SSH_HOST=
LEETCODE_LSP_SSH_USER=ubuntu
LEETCODE_LSP_SSH_PORT=22
LEETCODE_LSP_TARGET_PORT=9092

# Use an absolute path. Never commit the private key.
LEETCODE_LSP_SSH_IDENTITY_FILE=/absolute/path/to/ssh_private_key
